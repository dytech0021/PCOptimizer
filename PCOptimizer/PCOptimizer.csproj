<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- <ApplicationIcon> so carimba o icone no .exe; embutir tambem como
         recurso deixa o TrayService usar o mesmo arquivo na bandeja. -->
    <EmbeddedResource Include="Assets\icon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>PCOptimizer</AssemblyName>
    <RootNamespace>PCOptimizer</RootNamespace>
    <Version>1.85.0</Version>
    <AssemblyVersion>1.85.0.0</AssemblyVersion>
    <FileVersion>1.85.0.0</FileVersion>
    <Product>PC Optimizer</Product>
    <Company>dytech0021</Company>
    <!-- Debug (F5): sem admin. Release (.exe publicado): exige admin. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
