<Window x:Class="PCOptimizer.Views.BrightnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="356" SizeToContent="Height" MaxHeight="820"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="FloatButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource ButtonSecondaryHover}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource FloatButtonStyle}">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style x:Key="SectionShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="50"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="SliderLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1" CornerRadius="14" Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource NavBg}" CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Height="26" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tela" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Segoe UI Variable Display" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtMonitorCount" Text="Detectando monitores…"
                                   Foreground="{DynamicResource TextMuted}" FontFamily="Cascadia Mono" FontSize="9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Apagar" Style="{StaticResource FloatButtonStyle}" Margin="0,0,5,0"
                                ToolTip="Desligar monitores" Click="BtnMonitorsOff_Click"/>
                        <Button Content="Capturar" Style="{StaticResource FloatButtonStyle}" Margin="0,0,5,0"
                                ToolTip="Capturar todas as telas" Click="BtnScreenshot_Click"/>
                        <Button x:Name="BtnTimerToggle" Content="Timer" Style="{StaticResource FloatButtonStyle}"
                                Margin="0,0,5,0" ToolTip="Agendar desligamento" Click="BtnTimerToggle_Click"/>
                        <Button Content="×" Style="{StaticResource FloatButtonStyle}" FontSize="16"
                                ToolTip="Fechar" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="760" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,10,12,12">
                    <StackPanel x:Name="PnlMonitors"/>

                    <TextBlock Text="PRESETS" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Cascadia Mono" FontSize="9" Margin="2,12,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPreset1" Grid.Column="0" Style="{StaticResource PresetButtonStyle}"
                                Click="Preset1_Click" MouseRightButtonUp="Preset1_Edit">
                            <StackPanel>
                                <TextBlock x:Name="TxtPreset1Icon" HorizontalAlignment="Center" FontSize="15"/>
                                <TextBlock x:Name="TxtPreset1Name" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPreset1Values" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="8" Opacity="0.7"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPreset2" Grid.Column="1" Style="{StaticResource PresetButtonStyle}"
                                Click="Preset2_Click" MouseRightButtonUp="Preset2_Edit">
                            <StackPanel>
                                <TextBlock x:Name="TxtPreset2Icon" HorizontalAlignment="Center" FontSize="15"/>
                                <TextBlock x:Name="TxtPreset2Name" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPreset2Values" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="8" Opacity="0.7"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPreset3" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Margin="0"
                                Click="Preset3_Click" MouseRightButtonUp="Preset3_Edit">
                            <StackPanel>
                                <TextBlock x:Name="TxtPreset3Icon" HorizontalAlignment="Center" FontSize="15"/>
                                <TextBlock x:Name="TxtPreset3Name" HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPreset3Values" HorizontalAlignment="Center" FontFamily="Cascadia Mono" FontSize="8" Opacity="0.7"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="TimerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Border Style="{StaticResource SectionShellStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Desligamento agendado" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtTimerStatus" Text="Inativo" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="10"/>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Content="15 min" Tag="15" Style="{StaticResource FloatButtonStyle}" Margin="0,0,5,0" Click="TimerPreset_Click"/>
                                    <Button Content="30 min" Tag="30" Style="{StaticResource FloatButtonStyle}" Margin="0,0,5,0" Click="TimerPreset_Click"/>
                                    <Button Content="1 h" Tag="60" Style="{StaticResource FloatButtonStyle}" Margin="0,0,5,0" Click="TimerPreset_Click"/>
                                    <Button Content="2 h" Tag="120" Style="{StaticResource FloatButtonStyle}" Click="TimerPreset_Click"/>
                                </UniformGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTimerCustom" Height="30" Padding="8,5" Text="45"
                                             Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource SurfaceRaised}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                    <Button Grid.Column="1" Content="Aplicar" Style="{StaticResource FloatButtonStyle}" Margin="6,0,0,0" Click="TimerCustom_Click"/>
                                    <Button Grid.Column="2" x:Name="BtnTimerCancel" Content="Cancelar" Style="{StaticResource FloatButtonStyle}" Margin="6,0,0,0" Click="TimerCancel_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,10,0,0" Style="{StaticResource SectionShellStyle}"
                            Cursor="Hand" MouseLeftButtonDown="NightSection_Toggle">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Luz noturna" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                <TextBlock Text="Temperatura e filtro quente" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="TxtNightArrow" Text="▸" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="NightSection" Visibility="Collapsed" Margin="0,7,0,0">
                        <Border Style="{StaticResource SectionShellStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Filtro do PC Optimizer" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkNightLight" Checked="ChkNightLight_Checked" Unchecked="ChkNightLight_Unchecked"/>
                                </Grid>
                                <Grid x:Name="NightLightPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Intensidade" Style="{StaticResource SliderLabelStyle}"/>
                                    <Slider Grid.Column="1" x:Name="SliderNightLight" Minimum="0" Maximum="100" Value="35" ValueChanged="SliderNightLight_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtNightLightValue" Text="35%" Style="{StaticResource SliderValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Luz noturna do Windows" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkWinNightLight" Checked="ChkWinNightLight_Checked" Unchecked="ChkWinNightLight_Unchecked"/>
                                </Grid>
                                <Grid x:Name="WinNightLightPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Temperatura" Style="{StaticResource SliderLabelStyle}"/>
                                    <Slider Grid.Column="1" x:Name="SliderWinNightLight" Minimum="0" Maximum="100" Value="50" ValueChanged="SliderWinNightLight_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtWinNightLightValue" Text="50%" Style="{StaticResource SliderValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,7,0,0" Style="{StaticResource SectionShellStyle}"
                            Cursor="Hand" MouseLeftButtonDown="AdvColor_Toggle">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SignalCyan}" CornerRadius="3"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Cor avançada" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                <TextBlock Text="Gama, temperatura, saturação e RGB" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="TxtAdvColorArrow" Text="▸" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="AdvColorPanel" Visibility="Collapsed" Margin="0,7,0,0">
                        <Border Style="{StaticResource SectionShellStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Gama" Style="{StaticResource SliderLabelStyle}"/><Slider Grid.Column="1" x:Name="SliderGamma" Minimum="0.5" Maximum="2" Value="1" TickFrequency="0.05" ValueChanged="AdvColor_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtGammaValue" Text="1.00" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Temperatura" Style="{StaticResource SliderLabelStyle}"/><Slider Grid.Column="1" x:Name="SliderColorTemp" Minimum="3000" Maximum="9000" Value="6500" TickFrequency="100" ValueChanged="AdvColor_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtColorTempValue" Text="6500K" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Grid x:Name="SaturationRow" Visibility="Collapsed" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Saturação" Style="{StaticResource SliderLabelStyle}"/><Slider Grid.Column="1" x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="SliderSaturation_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtSaturationValue" Text="0%" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Ganho R" Style="{StaticResource SliderLabelStyle}" Foreground="#FF6B6B"/><Slider Grid.Column="1" x:Name="SliderGainR" Minimum="50" Maximum="150" Value="100" ValueChanged="AdvColor_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtGainRValue" Text="100%" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Ganho G" Style="{StaticResource SliderLabelStyle}" Foreground="#5EEA88"/><Slider Grid.Column="1" x:Name="SliderGainG" Minimum="50" Maximum="150" Value="100" ValueChanged="AdvColor_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtGainGValue" Text="100%" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="Ganho B" Style="{StaticResource SliderLabelStyle}" Foreground="#6BA8FF"/><Slider Grid.Column="1" x:Name="SliderGainB" Minimum="50" Maximum="150" Value="100" ValueChanged="AdvColor_ValueChanged"/><TextBlock Grid.Column="2" x:Name="TxtGainBValue" Text="100%" Style="{StaticResource SliderValueStyle}"/></Grid>
                                <Button Content="Restaurar cor padrão" Style="{StaticResource FloatButtonStyle}" HorizontalAlignment="Left" Click="BtnAdvColorReset_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,7,0,0" Style="{StaticResource SectionShellStyle}"
                            Cursor="Hand" MouseLeftButtonDown="Displays_Toggle">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource WarningBrush}" CornerRadius="3"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Modos de exibição" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                <TextBlock Text="HDR, WCG e ajustes por monitor" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="TxtDisplaysArrow" Text="▸" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="DisplaysPanel" Visibility="Collapsed" Margin="0,7,0,0">
                        <Border Style="{StaticResource SectionShellStyle}">
                            <StackPanel>
                                <StackPanel x:Name="PnlDisplayToggles"/>
                                <Grid x:Name="RemoteRow" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BtnRemoteMode" Content="Modo remoto" Style="{StaticResource FloatButtonStyle}" Click="BtnRemoteMode_Click"/>
                                    <Button Grid.Column="1" x:Name="BtnRemoteTune" Content="Calibrar" Style="{StaticResource FloatButtonStyle}" Margin="7,0,0,0" Click="BtnRemoteTune_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,10,0,0" Style="{StaticResource SectionShellStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Atalho global" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtHotkey" Text="Não definido" Foreground="{DynamicResource TextSecondary}" FontFamily="Cascadia Mono" FontSize="10" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnSetHotkey" Content="Definir" Style="{StaticResource FloatButtonStyle}" VerticalAlignment="Center" Click="BtnSetHotkey_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
