<Window x:Class="PCOptimizer.Views.BrightnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" Height="510"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ScreenshotBtnStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="16"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="35" Opacity="0.65" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header arrastável -->
            <Grid Grid.Row="0" Margin="0,0,0,12"
                  MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌞" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Brilho e Contraste" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtMonitorCount" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Detectando monitores..."/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🌑" Click="BtnMonitorsOff_Click" Cursor="Hand"
                            Style="{StaticResource ScreenshotBtnStyle}"
                            Background="{DynamicResource Card2Bg}"
                            Width="32" Height="32" FontSize="15" Padding="0"
                            BorderThickness="0" Margin="0,0,6,0"
                            ToolTip="Desligar todos os monitores — religam ao mexer o mouse ou teclar"/>
                    <Button Content="📸" Click="BtnScreenshot_Click" Cursor="Hand"
                            Style="{StaticResource ScreenshotBtnStyle}"
                            Background="{DynamicResource Card6Bg}"
                            Width="32" Height="32" FontSize="15" Padding="0"
                            BorderThickness="0" Margin="0,0,6,0"
                            ToolTip="Capturar área da tela"/>
                    <Button x:Name="BtnTimerToggle" Content="⏻" Click="BtnTimerToggle_Click" Cursor="Hand"
                            Style="{StaticResource ScreenshotBtnStyle}"
                            Background="{DynamicResource Card1Bg}"
                            Width="32" Height="32" FontSize="15" Padding="0"
                            BorderThickness="0" Margin="0,0,6,0"
                            ToolTip="Timer para desligar o computador"/>
                    <Button Content="✕" Click="BtnClose_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            FontSize="13" Foreground="{DynamicResource TextSecondary}"
                            Width="26" Height="26"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Painel dinâmico de monitores + modo acesso remoto -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlMonitors"/>
                </ScrollViewer>
                <Grid x:Name="RemoteRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRemoteMode" Padding="0,8" FontSize="11" FontWeight="SemiBold"
                            Cursor="Hand" BorderThickness="1"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderBrush="{DynamicResource Preset2Border}"
                            Click="BtnRemoteMode_Click"/>
                    <Button x:Name="BtnRemoteTune" Grid.Column="1" Content="🔬"
                            Margin="6,0,0,0" Padding="9,8" FontSize="12"
                            Cursor="Hand" BorderThickness="1"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            ToolTip="Ajustes finos — ligar cada etapa separadamente"
                            Click="BtnRemoteTune_Click"/>
                </Grid>
            </StackPanel>

            <!-- Row 2: Presets -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Presets (clique direito para editar)" FontSize="9"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" Opacity="0.7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPreset1" Grid.Column="0" Cursor="Hand"
                            Margin="0,0,4,0" Padding="0,8"
                            Background="{DynamicResource Preset1Bg}"
                            Foreground="{DynamicResource Preset1Fg}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Preset1Border}"
                            Click="Preset1_Click" MouseRightButtonUp="Preset1_Edit">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPreset1Icon" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset1Name" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset1Values" FontSize="9" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPreset2" Grid.Column="1" Cursor="Hand"
                            Margin="2,0,2,0" Padding="0,8"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Preset2Border}"
                            Click="Preset2_Click" MouseRightButtonUp="Preset2_Edit">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPreset2Icon" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset2Name" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset2Values" FontSize="9" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPreset3" Grid.Column="2" Cursor="Hand"
                            Margin="4,0,0,0" Padding="0,8"
                            Background="{DynamicResource Preset3Bg}"
                            Foreground="{DynamicResource Preset3Fg}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Preset3Border}"
                            Click="Preset3_Click" MouseRightButtonUp="Preset3_Edit">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPreset3Icon" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset3Name" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPreset3Values" FontSize="9" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Row 3: Divider -->
            <Border Grid.Row="3" Height="1"
                    Background="{DynamicResource BorderColor}"
                    Margin="0,0,0,10"/>

            <!-- Row 4: Luz Noturna toggle -->
            <Grid Grid.Row="4" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🌙" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Luz Noturna" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <CheckBox x:Name="ChkNightLight" Grid.Column="2" VerticalAlignment="Center"
                          Checked="ChkNightLight_Checked" Unchecked="ChkNightLight_Unchecked"/>
            </Grid>

            <!-- Row 5: Luz Noturna slider -->
            <Grid Grid.Row="5" Margin="0,0,0,12" x:Name="NightLightPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔥" FontSize="13" VerticalAlignment="Center" Opacity="0.7"/>
                <Slider x:Name="SliderNightLight" Grid.Column="1"
                        Minimum="10" Maximum="100" Value="40"
                        VerticalAlignment="Center"
                        ValueChanged="SliderNightLight_ValueChanged"/>
                <TextBlock x:Name="TxtNightLightValue" Grid.Column="2"
                           Text="40%" FontSize="12" FontWeight="Bold"
                           Foreground="#F9E2AF"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Row 6: Luz Noturna Windows toggle -->
            <Grid Grid.Row="6" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🌙" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Luz Noturna (Windows)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <CheckBox x:Name="ChkWinNightLight" Grid.Column="2" VerticalAlignment="Center"
                          Checked="ChkWinNightLight_Checked" Unchecked="ChkWinNightLight_Unchecked"/>
            </Grid>

            <!-- Row 7: Luz Noturna Windows slider (colapsável) -->
            <Grid Grid.Row="7" Margin="0,0,0,12" x:Name="WinNightLightPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔆" FontSize="13" VerticalAlignment="Center" Opacity="0.7"/>
                <Slider x:Name="SliderWinNightLight" Grid.Column="1"
                        Minimum="0" Maximum="100" Value="50"
                        VerticalAlignment="Center"
                        ValueChanged="SliderWinNightLight_ValueChanged"/>
                <TextBlock x:Name="TxtWinNightLightValue" Grid.Column="2"
                           Text="50%" FontSize="12" FontWeight="Bold"
                           Foreground="#F9E2AF"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Row 8: Cor avançada — cabeçalho clicável (expande/recolhe) -->
            <Grid Grid.Row="8" Margin="0,0,0,6" Cursor="Hand" Background="Transparent"
                  MouseLeftButtonDown="AdvColor_Toggle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🎨" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Cor avançada (gama, temperatura, RGB)"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtAdvColorArrow" Grid.Column="2" Text="▸" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 9: Cor avançada — painel (recolhido por padrão) -->
            <StackPanel Grid.Row="9" x:Name="AdvColorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <!-- Gama -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="γ" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" ToolTip="Gama"/>
                    <Slider x:Name="SliderGamma" Grid.Column="1"
                            Minimum="0.5" Maximum="2.5" Value="1.0"
                            VerticalAlignment="Center"
                            ValueChanged="AdvColor_ValueChanged"/>
                    <TextBlock x:Name="TxtGammaValue" Grid.Column="2" Text="1.00"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <!-- Temperatura de cor -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🌡" FontSize="12" VerticalAlignment="Center" Opacity="0.8"
                               ToolTip="Temperatura de cor (menos = mais quente/alaranjado)"/>
                    <Slider x:Name="SliderColorTemp" Grid.Column="1"
                            Minimum="2000" Maximum="10000" Value="6500"
                            TickFrequency="100" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="AdvColor_ValueChanged"/>
                    <TextBlock x:Name="TxtColorTempValue" Grid.Column="2" Text="6500K"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <!-- Saturação (Digital Vibrance — só NVIDIA) -->
                <Grid x:Name="SaturationRow" Margin="0,0,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🎨" FontSize="12" VerticalAlignment="Center" Opacity="0.8"
                               ToolTip="Saturação das cores (vibração digital)"/>
                    <Slider x:Name="SliderSaturation" Grid.Column="1"
                            Minimum="0" Maximum="63" Value="0"
                            VerticalAlignment="Center"
                            ValueChanged="SliderSaturation_ValueChanged"/>
                    <TextBlock x:Name="TxtSaturationValue" Grid.Column="2" Text="0%"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Ganho R / G / B -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="#F38BA8"/>
                    <Slider x:Name="SliderGainR" Grid.Column="1"
                            Minimum="25" Maximum="100" Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="AdvColor_ValueChanged"/>
                    <TextBlock x:Name="TxtGainRValue" Grid.Column="2" Text="100%"
                               FontSize="11" FontWeight="Bold" Foreground="#F38BA8"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="#A6E3A1"/>
                    <Slider x:Name="SliderGainG" Grid.Column="1"
                            Minimum="25" Maximum="100" Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="AdvColor_ValueChanged"/>
                    <TextBlock x:Name="TxtGainGValue" Grid.Column="2" Text="100%"
                               FontSize="11" FontWeight="Bold" Foreground="#A6E3A1"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="#89B4FA"/>
                    <Slider x:Name="SliderGainB" Grid.Column="1"
                            Minimum="25" Maximum="100" Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="AdvColor_ValueChanged"/>
                    <TextBlock x:Name="TxtGainBValue" Grid.Column="2" Text="100%"
                               FontSize="11" FontWeight="Bold" Foreground="#89B4FA"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <!-- Rodapé: aviso + restaurar -->
                <Grid>
                    <TextBlock Text="Vale para todos os monitores" FontSize="9" Opacity="0.6"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button Content="↩ Restaurar padrão" HorizontalAlignment="Right"
                            Padding="10,4" FontSize="10" Cursor="Hand"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Click="BtnAdvColorReset_Click"/>
                </Grid>
            </StackPanel>

            <!-- Row 10: Timer de desligamento (colapsável) -->
            <StackPanel Grid.Row="10" x:Name="TimerPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⏻" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Desligar o PC" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="TxtTimerStatus" Grid.Column="2" FontSize="11" FontWeight="Bold"
                               Foreground="#F38BA8" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="15min" Grid.Column="0" Tag="15" Click="TimerPreset_Click" Cursor="Hand"
                            Margin="0,0,3,0" Padding="0,7" FontSize="11"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset2Border}"/>
                    <Button Content="30min" Grid.Column="1" Tag="30" Click="TimerPreset_Click" Cursor="Hand"
                            Margin="3,0,3,0" Padding="0,7" FontSize="11"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset2Border}"/>
                    <Button Content="1h" Grid.Column="2" Tag="60" Click="TimerPreset_Click" Cursor="Hand"
                            Margin="3,0,3,0" Padding="0,7" FontSize="11"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset2Border}"/>
                    <Button Content="2h" Grid.Column="3" Tag="120" Click="TimerPreset_Click" Cursor="Hand"
                            Margin="3,0,0,0" Padding="0,7" FontSize="11"
                            Background="{DynamicResource Preset2Bg}"
                            Foreground="{DynamicResource Preset2Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset2Border}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⏱️" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTimerCustom" Grid.Column="1" FontSize="11"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Margin="6,0,6,0" Padding="6,4"
                             Background="{DynamicResource SurfaceBg}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                             ToolTip="Minutos personalizados"/>
                    <Button Content="OK" Grid.Column="2" Click="TimerCustom_Click" Cursor="Hand"
                            Padding="12,5" FontSize="11" Margin="0,0,4,0"
                            Background="{DynamicResource Preset3Bg}"
                            Foreground="{DynamicResource Preset3Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset3Border}"/>
                    <Button x:Name="BtnTimerCancel" Content="Cancelar" Grid.Column="3" Click="TimerCancel_Click" Cursor="Hand"
                            Padding="10,5" FontSize="11" Visibility="Collapsed"
                            Background="{DynamicResource Preset1Bg}"
                            Foreground="{DynamicResource Preset1Fg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Preset1Border}"/>
                </Grid>
            </StackPanel>

            <!-- Row 11: Divider -->
            <Border Grid.Row="11" Height="1"
                    Background="{DynamicResource BorderColor}"
                    Margin="0,0,0,10" x:Name="Divider2"/>

            <!-- Row 12: Atalho e status -->
            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌨️ " FontSize="11"/>
                        <TextBlock x:Name="TxtHotkey" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnSetHotkey" Grid.Column="1"
                        Content="Alterar" Padding="10,5"
                        Background="Transparent"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        FontSize="11" Cursor="Hand" Click="BtnSetHotkey_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>
