<Window x:Class="PCOptimizer.Views.RemoteTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso Remoto — ajustes finos" Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" Topmost="True"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="10" CornerRadius="12"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" Opacity="0.4" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel Margin="20,16">
            <TextBlock Text="🔬 Acesso Remoto — ajustes finos" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Cada opção é aplicada NA HORA, uma de cada vez."
                       FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>

            <Border CornerRadius="8" Padding="10,8" Margin="0,12,0,14"
                    Background="#0D1628" BorderBrush="#1B2E50" BorderThickness="1">
                <TextBlock FontSize="10" Foreground="#93C5FD" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Para achar o que estraga a cor: "/>
                    <Run Text="ligue UMA opção, olhe a imagem no AnyDesk, e anote se piorou. Depois desligue e teste a próxima. A que piorar é a culpada — deixe ela desligada e use as outras."/>
                </TextBlock>
            </Border>

            <CheckBox x:Name="ChkSingle" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"
                      Click="ChkSingle_Click">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Somente a tela principal" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Desativa as outras telas (layout volta ao desmarcar)" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ChkRes" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"
                      Click="ChkRes_Click">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Resolução 1920×1080 (16:9)" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtResNote" Text="Volta à nativa ao desmarcar" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ChkHdrOff" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"
                      Click="ChkHdrOff_Click">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Desligar o HDR" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Suspeito nº 1 de imagem saturada/escura no acesso remoto" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ChkAcmOff" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"
                      Click="ChkAcmOff_Click">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Desligar cores automáticas (ACM)" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtAcmNote" Text="Windows 11 24H2+ — pode não existir neste PC" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </CheckBox>

            <Border CornerRadius="8" Padding="10,9" Margin="0,10,0,0"
                    Background="#0B2818" BorderBrush="#1C5138" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="ChkKeepSdr" Foreground="{DynamicResource TextPrimary}"
                              Click="ChkKeepSdr_Click">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Manter SDR puro automaticamente" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#86EFAC"/>
                            <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="#6EE7B7"
                                       Text="Corrige sozinho a saturação que volta a cada reconexão do acesso remoto — faz o mesmo ciclo de ligar e desligar o HDR que resolve na mão."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="9,7" Margin="0,10,0,0"
                    Background="#12202E" BorderBrush="#24415C" BorderThickness="1">
                <TextBlock x:Name="TxtColorMode" FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="#7DD3FC"
                           Text="Lendo o modo de cor..."/>
            </Border>

            <TextBlock x:Name="TxtTuneStatus" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Grid Margin="0,14,0,0">
                <Button Content="↩ Reverter tudo" HorizontalAlignment="Left"
                        Padding="14,7" FontSize="11" Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        Click="BtnRevertAll_Click"/>
                <Button Content="Fechar" HorizontalAlignment="Right" Padding="16,7"
                        Background="{DynamicResource ButtonPrimaryBg}"
                        Foreground="{DynamicResource ButtonPrimaryFg}"
                        BorderThickness="0" FontSize="12" FontWeight="Bold"
                        Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
