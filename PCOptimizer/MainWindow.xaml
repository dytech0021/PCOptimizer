<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Optimizer" Width="1180" Height="780"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource ButtonSecondaryHover}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource RunButtonText}"/>
            <Setter Property="Background" Value="{DynamicResource RunButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RunButtonBg}"/>
        </Style>

        <Style x:Key="NavTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="ActiveSpine" Width="3" HorizontalAlignment="Left"
                                    Margin="0,8" CornerRadius="0,2,2,0" Background="Transparent"/>
                            <Border x:Name="NavSurface" Margin="8,0,10,0" CornerRadius="8" Background="Transparent">
                                <ContentPresenter Margin="18,0,12,0" VerticalAlignment="Center"
                                                  ContentSource="Header"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveSpine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AccentStripBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ActionCardStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="OptionRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ListItemBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="OptionCheckStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Text" Value="—"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>

        <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="28,24,20,24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="92"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="PC" Foreground="{DynamicResource RunButtonText}" FontSize="11"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="PC Optimizer" Foreground="{DynamicResource TextPrimary}"
                               FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="16"/>
                    <Border Margin="10,0,0,0" Padding="7,3" CornerRadius="5"
                            Background="{DynamicResource BadgeBg}" Cursor="Hand"
                            MouseLeftButtonUp="VersionBadge_Click">
                        <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource BadgeText}"
                                   FontFamily="Cascadia Mono" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnScreenshot" Content="Capturar" Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Capturar todas as telas" Click="BtnScreenshot_Click"/>
                    <Button x:Name="BtnBrightness" Content="Tela" Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Abrir controle flutuante de tela" Click="BtnBrightnessHeader_Click"/>
                    <Button x:Name="BtnThemeToggle" Content="{DynamicResource ThemeToggleIcon}"
                            Style="{StaticResource ChromeButtonStyle}" ToolTip="Alternar tema"
                            Click="BtnThemeToggle_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="OptList" TabStripPlacement="Left"
                    ItemContainerStyle="{StaticResource NavTabStyle}"
                    Background="{DynamicResource WindowBg}" BorderThickness="0">
            <TabItem Header="Visão geral">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Visão geral" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Seu centro de controle, agora com ações essenciais à vista."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>

                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                                <StackPanel Grid.Column="1" Margin="16,2,20,2">
                                    <TextBlock Text="Pronto para otimizar" Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="18"/>
                                    <TextBlock Text="Escolha um perfil rápido ou ajuste cada área separadamente."
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Controle de tela" Style="{StaticResource ActionButtonStyle}"
                                            Margin="0,0,8,0" Click="BtnBrightnessHeader_Click"/>
                                    <Button Content="Capturar telas" Style="{StaticResource ActionButtonStyle}"
                                            Click="BtnScreenshot_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Fluxo recomendado" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="1" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11"/>
                                    <TextBlock Text="Selecione um perfil" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,12"/>
                                    <TextBlock Text="2" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11"/>
                                    <TextBlock Text="Revise as opções nas áreas laterais" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,12"/>
                                    <TextBlock Text="3" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="11"/>
                                    <TextBlock Text="Execute pela barra inferior" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Atividade" Style="{StaticResource SectionTitleStyle}"/>
                                    <ScrollViewer x:Name="LogScroller" Height="150" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtLog" Text="Aguardando uma ação…" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono" FontSize="10"
                                                   Foreground="{DynamicResource LogText}"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tela &amp; cor">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Tela &amp; cor" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Brilho, HDR, WCG, temperatura e captura em um único fluxo."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ActionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Controle flutuante" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Ajuste cada monitor sem sair do que está fazendo."
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" Content="Abrir controle" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnBrightnessHeader_Click"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ActionCardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Maximizar qualidade" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Aplica resolução, taxa e recursos de cor compatíveis."
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtMaximizeStatus" Text="Pronto" Style="{StaticResource StatusTextStyle}"
                                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="BtnMaximizeDisplay" Content="Aplicar" Style="{StaticResource ActionButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnMaximizeDisplay_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="O que o controle reúne" Style="{StaticResource SectionTitleStyle}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="MONITORES" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono" FontSize="10"/>
                                        <TextBlock Text="Brilho independente por tela e presets rápidos." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="HDR / WCG" Foreground="{DynamicResource SignalCyan}" FontFamily="Cascadia Mono" FontSize="10"/>
                                        <TextBlock Text="Estado real por monitor e controles compatíveis." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="COR" Foreground="{DynamicResource TextMuted}" FontFamily="Cascadia Mono" FontSize="10"/>
                                        <TextBlock Text="Luz noturna, gama, ganhos RGB e saturação." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Desempenho">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Desempenho" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Perfis imediatos e ajustes focados em responsividade."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ActionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Game Boost" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Libera recursos e prioriza a sessão atual." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtGameBoostStatus" Text="Inativo" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                                    <Button x:Name="BtnGameBoost" Content="Ativar agora" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Click="BtnGameBoost_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ActionCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Modo competitivo" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Aplica um perfil agressivo e reversível para jogos." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtCompetitiveStatus" Text="Inativo" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                                    <Button x:Name="BtnCompetitive" Content="Ativar competitivo" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="BtnCompetitive_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Ajustes selecionáveis" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkPowerPlan" Content="Plano de energia" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusPowerPlan" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkVisualEffects" Content="Efeitos visuais" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusVisualEffects" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkBackgroundApps" Content="Apps em segundo plano" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusBackgroundApps" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkStandbyRam" Content="Memória standby" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusStandbyRam" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkBootProcessors" Content="Processadores no boot" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusBootProcessors" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkGameMode" Content="Modo de Jogo" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusGameMode" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkGpuScheduling" Content="Agendamento de GPU" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusGpuScheduling" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkGameBar" Content="Game Bar e gravação" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusGameBar" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkGamePriority" Content="Prioridade de jogos" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusGamePriority" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkGameNetwork" Content="Rede para jogos" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusGameNetwork" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkPowerThrottling" Content="Power throttling" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusPowerThrottling" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkFullscreenOpt" Content="Otimização de tela cheia" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusFullscreenOpt" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkMousePrecision" Content="Precisão do mouse" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusMousePrecision" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sistema">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Sistema" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Manutenção, inicialização e ferramentas administrativas agrupadas."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <Border Style="{StaticResource ActionCardStyle}"><StackPanel><TextBlock Text="Autologon" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="TxtAutologonStatus" Text="Não configurado" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button x:Name="BtnAutologon" Content="Configurar" Style="{StaticResource ActionButtonStyle}" Click="BtnAutologon_Click"/></StackPanel></Border>
                            <Border Style="{StaticResource ActionCardStyle}"><StackPanel><TextBlock Text="Wake-on-LAN" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="TxtWoLStatus" Text="Não configurado" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button x:Name="BtnWoL" Content="Configurar" Style="{StaticResource ActionButtonStyle}" Click="BtnWoL_Click"/></StackPanel></Border>
                            <Border Style="{StaticResource ActionCardStyle}"><StackPanel><TextBlock Text="Barra de tarefas" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="TxtTaskbarStatus" Text="Padrão" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button x:Name="BtnTaskbar" Content="Configurar" Style="{StaticResource ActionButtonStyle}" Click="BtnTaskbar_Click"/></StackPanel></Border>
                            <Border Style="{StaticResource ActionCardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Reparo profundo" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="TxtDeepRepairStatus" Text="Disponível" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button x:Name="BtnDeepRepair" Content="Reparar" Style="{StaticResource ActionButtonStyle}" Click="BtnDeepRepair_Click"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Limpeza &amp; armazenamento" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkTemp" Content="Arquivos temporários" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusTemp" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkDisk" Content="Limpeza de disco" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusDisk" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkRecycleBin" Content="Lixeira" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusRecycleBin" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkWinUpdateCache" Content="Cache do Windows Update" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusWinUpdateCache" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkThumbnails" Content="Cache de miniaturas" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusThumbnails" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkShaderCache" Content="Cache de shaders" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusShaderCache" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkSsdTrim" Content="TRIM de SSD" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusSsdTrim" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkDefrag" Content="Desfragmentação" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusDefrag" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkHibernation" Content="Desativar hibernação" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusHibernation" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Windows &amp; manutenção" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkStartup" Content="Inicialização" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusStartup" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkServices" Content="Serviços" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusServices" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkNetwork" Content="Rede" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusNetwork" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkRegistry" Content="Registro" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusRegistry" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkFastStartup" Content="Inicialização rápida" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusFastStartup" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkSystemRepair" Content="Reparo do sistema" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusSystemRepair" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkFixDate" Content="Corrigir data e hora" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusFixDate" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkBloatware" Content="Remover bloatware" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusBloatware" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Segurança">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Segurança" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Verificação, privacidade e proteções com impacto explícito."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Verificação antimalware" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Abre o fluxo de verificação do Microsoft Defender."
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnMalware" Content="Verificar agora"
                                        Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                        Click="BtnMalware_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Privacidade &amp; proteção" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkTelemetry" Content="Reduzir telemetria" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusTelemetry" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkCortana" Content="Desativar Cortana" IsChecked="True" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusCortana" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkCoreIsolation" Content="Isolamento do núcleo" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="OptCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusCoreIsolation" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,8,8">
                                    <TextBlock Text="Atenção: ajustes de proteção que exigem reinício são mantidos desmarcados por padrão."
                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Expert">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel>
                        <TextBlock Text="Expert" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Controles avançados com aplicação manual e reversão visível."
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,20"/>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GPU — frequência" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="TxtGpuName" Text="Detectando GPU..." Foreground="{DynamicResource TextSecondary}" FontFamily="Cascadia Mono" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="MANUAL" Foreground="{DynamicResource WarningBrush}" FontFamily="Cascadia Mono" FontSize="10"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                    <TextBlock Text="Core offset" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SldGpuCore" Minimum="0" Maximum="200" Value="0" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="0–200" Style="{StaticResource StatusTextStyle}"/>
                                    <TextBlock Grid.Row="1" Text="Memory offset" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="SldGpuMem" Minimum="0" Maximum="500" Value="0" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="0–500" Style="{StaticResource StatusTextStyle}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnGpuOcApply" Content="Aplicar OC" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Click="BtnGpuOcApply_Click"/>
                                    <Button x:Name="BtnGpuPowerMax" Content="Power Limit Máx" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="BtnGpuPowerMax_Click"/>
                                    <TextBlock x:Name="TxtGpuOcStatus" Margin="14,0,0,0" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="GPU — undervolt" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnUvLeve" Content="Leve" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Click="BtnUvLeve_Click"/>
                                    <Button x:Name="BtnUvMedio" Content="Médio" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="BtnUvMedio_Click"/>
                                    <Button x:Name="BtnUvAgressivo" Content="Agressivo" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="BtnUvAgressivo_Click"/>
                                    <Button x:Name="BtnGpuRevert" Content="Reverter para stock" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Click="BtnGpuRevert_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtGpuUvStatus" Style="{StaticResource StatusTextStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ajustes avançados" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkExpertCpuMax" Content="CPU em desempenho máximo" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="ExpertCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusExpertCpuMax" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkExpertTimer" Content="Timer de baixa latência" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="ExpertCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusExpertTimer" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                                <Border Style="{StaticResource OptionRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ChkExpertMsi" Content="MSI mode para dispositivos" IsChecked="False" Style="{StaticResource OptionCheckStyle}" Checked="ExpertCheckChanged" Unchecked="OptCheckChanged"/><TextBlock Grid.Column="1" x:Name="StatusExpertMsi" Style="{StaticResource StatusTextStyle}"/></Grid></Border>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,27,8,8">
                                <StackPanel>
                                    <TextBlock Text="Undervolt de CPU" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="TxtCpuUvStatus" Text="Detectando ferramenta recomendada..." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button x:Name="BtnCpuUvTool" Content="Abrir ferramenta" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Click="BtnCpuUvTool_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource NavBg}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkSelectAll" Content="Selecionar tudo" Foreground="{DynamicResource TextPrimary}"
                                  VerticalAlignment="Center" Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>
                        <TextBlock x:Name="TxtSelected" Text="0 selecionadas" Foreground="{DynamicResource TextMuted}"
                                   FontFamily="Cascadia Mono" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Básico" Style="{StaticResource ChromeButtonStyle}" Margin="0" Click="BtnPresetBasica_Click"/>
                        <Button Content="Equilibrado" Style="{StaticResource ChromeButtonStyle}" Click="BtnPresetIntermediaria_Click"/>
                        <Button Content="Avançado" Style="{StaticResource ChromeButtonStyle}" Click="BtnPresetAvancada_Click"/>
                        <Button Content="Completo" Style="{StaticResource ChromeButtonStyle}" Click="BtnPresetFull_Click"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TxtProgress" Text="Pronto" Foreground="{DynamicResource TextSecondary}"
                               FontFamily="Cascadia Mono" FontSize="10" Margin="0,0,0,8"/>
                    <ProgressBar Grid.Row="1" x:Name="Progress" Height="4" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceRaised}"/>
                </Grid>
                <Button Grid.Column="2" x:Name="BtnRun" Content="Executar otimização"
                        Style="{StaticResource PrimaryButtonStyle}" Height="52" MinWidth="180"
                        FontSize="13" Click="BtnRun_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
